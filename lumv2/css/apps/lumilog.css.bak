.lumilog-app,
.lumilog-app * {
  box-sizing: border-box;
}

.lumilog-app {
  position: relative;
  padding: 8px 10px 20px;
}

.lumilog-shell,
.lumilog-content,
.lumilog-archive-section,
.lumilog-archive-list,
.lumilog-detail-section,
.lumilog-setlist-card,
.lumilog-photo-card,
.lumilog-memory-card,
.lumilog-personal-card {
  display: grid;
  gap: 10px;
}

.lumilog-image-slot {
  display: block;
  border: 1px solid #efc4d1;
  background: #fff8fa;
}

.lumilog-brand {
  min-height: 50px;
  display: grid;
  justify-items: center;
  align-content: center;
  gap: 3px;
}

.lumilog-brand span {
  color: #ef8dac;
  font-size: 25px;
  line-height: 1;
  font-weight: 800;
  letter-spacing: -0.06em;
}

.lumilog-brand strong {
  color: #8f6f7b;
  font-size: 15px;
  line-height: 1;
  font-weight: 900;
}

.lumilog-hero,
.lumilog-featured-card,
.lumilog-detail-hero,
.lumilog-detail-section,
.lumilog-setlist-card,
.lumilog-photo-card,
.lumilog-memory-card,
.lumilog-personal-card,
.lumilog-message-card,
.lumilog-archive-card,
.lumilog-memory-inner {
  border: 1px solid #efc8d4;
  border-radius: 22px;
  background: #fffdfd;
}

.lumilog-hero {
  display: grid;
  gap: 10px;
  padding: 12px;
}

.lumilog-hero-art {
  width: 100%;
  height: 108px;
  border-radius: 19px;
}

.lumilog-hero-copy {
  text-align: center;
}

.lumilog-hero-copy h2,
.lumilog-section-title h3 {
  margin: 0;
  color: #553543;
  font-size: 18px;
  line-height: 1.2;
  font-weight: 900;
  letter-spacing: -0.05em;
}

.lumilog-hero-sub {
  margin: 7px 0 0;
  color: #7d5967;
  font-size: 13px;
  line-height: 1.35;
  font-weight: 800;
}

.lumilog-hero-note,
.lumilog-featured-copy p,
.lumilog-archive-copy p,
.lumilog-detail-copy p,
.lumilog-message-copy p,
.lumilog-memory-inner p {
  margin: 6px 0 0;
  color: #896875;
  font-size: 11px;
  line-height: 1.42;
  font-weight: 760;
}

.lumilog-featured-card {
  display: grid;
  grid-template-columns: 112px minmax(0, 1fr);
  gap: 12px;
  padding: 12px;
}

.lumilog-featured-image {
  width: 112px;
  min-height: 132px;
  border-radius: 18px;
}

.lumilog-featured-copy,
.lumilog-detail-copy,
.lumilog-archive-copy,
.lumilog-message-copy {
  min-width: 0;
}

.lumilog-featured-copy > span,
.lumilog-archive-copy > span,
.lumilog-detail-copy > span {
  color: #ef7fa0;
  font-size: 12px;
  line-height: 1.2;
  font-weight: 900;
}

.lumilog-featured-copy strong,
.lumilog-archive-copy strong,
.lumilog-detail-copy strong {
  display: block;
  margin-top: 6px;
  color: #553543;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 16px;
  line-height: 1.3;
  font-weight: 700;
  letter-spacing: -0.04em;
  word-break: keep-all;
  overflow-wrap: anywhere;
}

.lumilog-primary-btn,
.lumilog-link-btn,
.lumilog-tag-row span,
.lumilog-status-row span,
.lumilog-back-btn {
  border: 1px solid #efc8d4;
  background: #fffdfd;
  color: #795563;
  font-weight: 900;
}

.lumilog-primary-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  justify-self: start;
  width: 150px;
  min-height: 38px;
  margin-top: 10px;
  padding: 0 10px;
  border-radius: 12px;
  border-color: #ef84a4;
  background: #ef84a4;
  color: #fff;
  font-size: 13px;
}

.lumilog-status-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 5px;
  width: 100%;
  margin-top: 10px;
}

.lumilog-status-row span,
.lumilog-tag-row span {
  min-height: 28px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 7px;
  border-radius: 11px;
  font-size: 10px;
}

.lumilog-status-row span {
  min-width: 0;
  padding: 0 4px;
  text-align: center;
  white-space: nowrap;
  font-size: 8.5px;
}

.lumilog-tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: 10px;
}

.lumilog-section-title {
  text-align: center;
}

.lumilog-archive-card {
  display: grid;
  grid-template-columns: 78px minmax(0, 1fr) 66px;
  align-items: center;
  gap: 10px;
  padding: 10px;
}

.lumilog-archive-image {
  width: 78px;
  height: 68px;
  border-radius: 14px;
}

.lumilog-archive-copy strong {
  font-size: 15px;
}

.lumilog-link-btn {
  min-height: 34px;
  padding: 0 7px;
  border-radius: 11px;
  font-size: 11px;
}

.lumilog-back-btn {
  position: absolute;
  top: 10px;
  left: 10px;
  z-index: 2;
  width: 38px;
  height: 38px;
  border-radius: 50%;
  font-size: 0;
}

.lumilog-back-btn::before {
  content: '←';
  position: absolute;
  inset: 0;
  display: grid;
  place-items: center;
  color: #553543;
  font-size: 24px;
}

.lumilog-detail-hero {
  display: grid;
  grid-template-columns: 112px minmax(0, 1fr);
  gap: 12px;
  padding: 12px;
}

.lumilog-detail-main-image {
  width: 112px;
  min-height: 132px;
  border-radius: 18px;
}

.lumilog-detail-copy p {
  color: #7d5967;
  font-size: 12px;
}

.lumilog-subtitle {
  display: flex;
  align-items: center;
}

.lumilog-subtitle h3 {
  margin: 0;
  color: #553543;
  font-size: 16px;
  line-height: 1.2;
  font-weight: 900;
  letter-spacing: -0.05em;
}

.lumilog-detail-section,
.lumilog-setlist-card,
.lumilog-photo-card,
.lumilog-memory-card,
.lumilog-personal-card {
  gap: 8px;
  padding: 10px;
}

.lumilog-message-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
}

.lumilog-message-card {
  display: grid;
  grid-template-columns: 54px minmax(0, 1fr);
  gap: 8px;
  min-height: 72px;
  padding: 10px;
}

.lumilog-message-image {
  width: 54px;
  height: 54px;
  border-radius: 12px;
}

.lumilog-message-copy strong {
  display: block;
  margin: 0;
  color: #553543;
  font-size: 14px;
  line-height: 1.18;
  font-weight: 900;
  letter-spacing: -0.04em;
}

.lumilog-message-copy p {
  word-break: keep-all;
}

.lumilog-detail-split {
  display: grid;
  grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.12fr);
  gap: 10px;
}

.lumilog-setlist-card ol {
  display: grid;
  gap: 6px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.lumilog-setlist-card ol li {
  display: grid;
  grid-template-columns: 24px minmax(0, 1fr);
  gap: 8px;
  align-items: start;
  padding-bottom: 8px;
  border-bottom: 1px dashed #f0d7df;
}

.lumilog-setlist-card ol li:last-child {
  padding-bottom: 0;
  border-bottom: 0;
}

.lumilog-setlist-card ol li span {
  color: #ef7fa0;
  font-size: 10px;
  line-height: 1.35;
  font-weight: 900;
}

.lumilog-setlist-card ol li strong {
  display: block;
  margin: 0;
  color: #553543;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 10px;
  line-height: 1.18;
  font-weight: 700;
  letter-spacing: -0.04em;
  white-space: nowrap;
}

.lumilog-photo-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 4px;
}

.lumilog-photo-slot {
  width: 100%;
  aspect-ratio: 1.02 / 1;
  border-radius: 12px;
}

.lumilog-memory-inner {
  display: grid;
  grid-template-columns: 54px minmax(0, 1fr) 14px;
  align-items: center;
  gap: 10px;
  padding: 10px;
}

.lumilog-memory-image {
  width: 54px;
  height: 44px;
  border-radius: 12px;
}

.lumilog-memory-inner p {
  margin: 0;
}

.lumilog-arrow {
  color: #d2a2b2;
  font-size: 20px;
  line-height: 1;
  text-align: center;
}

.lumilog-personal-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr)) 102px;
  gap: 6px;
  align-items: end;
}

.lumilog-personal-item {
  position: relative;
  min-width: 0;
  display: grid;
  justify-items: center;
  align-content: end;
  gap: 6px;
  padding: 4px 6px 4px 2px;
  text-align: center;
}

.lumilog-personal-item:not(:last-of-type)::after {
  content: "";
  position: absolute;
  top: 6px;
  right: 0;
  width: 1px;
  height: 48px;
  border-right: 1px dashed #efc1cf;
}

.lumilog-personal-image {
  width: 36px;
  height: 36px;
  border-radius: 10px;
}

.lumilog-personal-item p {
  max-width: none;
  margin: 0;
  color: #7d5967;
  font-size: 9px;
  line-height: 1.2;
  font-weight: 780;
  white-space: nowrap;
}

.lumilog-record-btn {
  position: relative;
  align-self: end;
  justify-self: end;
  width: 102px;
  min-height: 32px;
  margin: 0;
  padding: 0 17px 0 6px;
  border-radius: 10px;
  font-size: 10px;
}

.lumilog-record-btn::after {
  content: "›";
  position: absolute;
  top: 50%;
  right: 7px;
  transform: translateY(-52%);
  font-size: 14px;
  line-height: 1;
  font-weight: 500;
}

@media (max-width: 360px) {
  .lumilog-detail-split {
    grid-template-columns: 1fr;
  }

  .lumilog-message-grid {
    grid-template-columns: 1fr;
  }

  .lumilog-personal-row {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .lumilog-record-btn {
    grid-column: 1 / -1;
    justify-self: stretch;
    width: 100%;
  }
}
