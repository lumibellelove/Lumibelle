/* ─────────────────────────────────────────
   LumiTalk
   Entry + channel detail share one file.
   Detail view uses one shell only:
   header / scrollable conversation / composer.
───────────────────────────────────────── */

.app-window.is-lumitalk-view .app-header {
  display: none;
}

.app-window.is-lumitalk-view .app-body {
  padding: 0 0 calc(var(--system-h) + 16px);
}

.app-window.is-lumitalk-view.is-lumitalk-detail {
  overflow: hidden;
}

.app-window.is-lumitalk-view.is-lumitalk-detail .app-body {
  display: flex;
  min-height: 0;
  padding: 0;
  overflow: hidden;
}

.app-window.is-lumitalk-view.is-lumitalk-detail .system-nav {
  display: none;
}

.lumitalk-app {
  position: relative;
  min-height: 100%;
  padding: 22px 16px 12px;
  background: var(--theme-bg);
}

.lumitalk-app.is-detail {
  width: 100%;
  height: 100%;
  min-height: 0;
  display: flex;
  flex-direction: column;
  padding: 0;
}

.lumitalk-head {
  margin: 4px 2px 18px;
  text-align: center;
}

.lumitalk-head h2 {
  margin: 0;
  color: var(--theme-text);
  font-size: 28px;
  line-height: 1.12;
  font-weight: 900;
  letter-spacing: -.08em;
}

.lumitalk-head p {
  margin: 8px 0 0;
  color: var(--theme-text-soft);
  font-size: 11px;
  line-height: 1.5;
  font-weight: 700;
}

.lumitalk-tabs {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 5px;
  margin: 0 0 16px;
  padding: 5px;
  border: 1px solid var(--theme-line);
  border-radius: 16px;
  background: var(--theme-card);
}

.lumitalk-tab {
  min-width: 0;
  min-height: 32px;
  position: relative;
  padding: 0 4px;
  border: 1px solid var(--theme-line);
  border-radius: 10px;
  background: transparent;
  color: var(--theme-text-soft);
  font-size: 10px;
  font-weight: 850;
  letter-spacing: -.04em;
  white-space: nowrap;
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
}

.lumitalk-tab.is-active {
  border-color: var(--theme-point);
  background: var(--theme-point);
  color: #fff;
}

.lumitalk-tab b {
  width: 15px;
  height: 15px;
  position: absolute;
  top: -6px;
  right: -4px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: var(--theme-point-deep);
  color: #fff;
  font-size: 8px;
  line-height: 1;
}

.lumitalk-content {
  display: grid;
  gap: 14px;
}

.lumitalk-app.is-detail .lumitalk-content,
.lumitalk-app.is-detail .lumitalk-content.is-detail {
  min-height: 0;
  flex: 1 1 auto;
  display: flex;
  gap: 0;
}

.lumitalk-profile-row,
.lumitalk-section-list,
.lumitalk-empty {
  border: 1px solid var(--theme-line);
  border-radius: var(--theme-radius-lg);
  background: var(--theme-card);
  box-shadow: 0 6px 16px rgba(130, 76, 99, .05);
}

.lumitalk-profile-row {
  width:100%;
  padding:0;
  text-align:left;
  font:inherit;
  cursor:pointer;
  min-height: 92px;
  display: grid;
  grid-template-columns: 64px minmax(0, 1fr);
  align-items: center;
  gap: 12px;
  padding: 14px 16px;
}

.lumitalk-profile-row > div,
.lumitalk-channel-copy,
.lumitalk-detail-copy,
.lumitalk-thread-copy {
  min-width: 0;
}

.lumitalk-profile-kicker {
  display: block;
  color: var(--theme-point-deep);
  font-size: 10px;
  font-weight: 900;
  letter-spacing: -.04em;
}

.lumitalk-profile-row strong {
  display: block;
  margin-top: 3px;
  overflow: hidden;
  color: var(--theme-text);
  font-size: 14px;
  line-height: 1.2;
  font-weight: 900;
  letter-spacing: -.06em;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.lumitalk-profile-row p,
.lumitalk-channel-copy p {
  margin: 5px 0 0;
  overflow: hidden;
  color: var(--theme-text-soft);
  font-size: 10px;
  line-height: 1.35;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.lumitalk-image-slot {
  width: 52px;
  height: 52px;
  display: block;
  border: 1px solid var(--theme-line);
  border-radius: 50%;
  background: rgba(255,255,255,.45);
}

.lumitalk-image-slot--profile {
  width: 58px;
  height: 58px;
}

.lumitalk-section h3 {
  margin: 0 0 8px;
  color: var(--theme-point-deep);
  font-size: 13px;
  line-height: 1.2;
  font-weight: 900;
  letter-spacing: -.06em;
}

.lumitalk-section-list {
  overflow: hidden;
}

.lumitalk-channel-row {
  min-height: 86px;
  display: grid;
  grid-template-columns: 62px minmax(0,1fr) 54px;
  align-items: center;
  gap: 12px;
  padding: 12px 16px;
  border-bottom: 1px solid var(--theme-line);
  cursor: pointer;
}

.lumitalk-channel-row:last-child {
  border-bottom: 0;
}

.lumitalk-channel-row.is-unavailable {
  cursor: default;
}

.lumitalk-channel-row.is-unavailable .lumitalk-channel-copy,
.lumitalk-channel-row.is-unavailable .lumitalk-channel-state {
  opacity: .84;
}

.lumitalk-channel-meta {
  min-height: 15px;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 4px;
  margin-bottom: 3px;
}

.lumitalk-meta-chip,
.lumitalk-status-chip,
.lumitalk-react-chip,
.lumitalk-action-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 19px;
  padding: 0 8px;
  border: 1px solid var(--theme-line);
  border-radius: 10px;
  background: rgba(255,255,255,.5);
  color: var(--theme-point-deep);
  font-size: 10px;
  line-height: 1;
  font-weight: 850;
  white-space: nowrap;
}

.lumitalk-meta-chip--group { border-color:#ead0d9; background:#fff9fb; color:#9b6678; }
.lumitalk-meta-chip--official { border-color:#d7b4c2; background:#faf2f5; color:#9e6679; }
.lumitalk-meta-chip--oshi { border-color:#edc9d4; background:#fffafd; color:#d96491; }
.lumitalk-meta-chip--help { border-color:#ddb0bd; background:#fff5f7; color:#b96172; }

.lumitalk-channel-copy strong {
  display: block;
  overflow: hidden;
  color: var(--theme-text);
  font-size: 12px;
  line-height: 1.22;
  font-weight: 900;
  letter-spacing: -.055em;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.lumitalk-channel-state {
  min-width: 0;
  width: 100%;
  align-self: start;
  display: grid;
  grid-template-areas: "time" "badge";
  justify-items: end;
  row-gap: 8px;
  margin-top: -2px;
}

.lumitalk-channel-state time { grid-area:time; justify-self:end; }
.lumitalk-channel-state .lumitalk-unread-badge { grid-area:badge; justify-self:end; }

.lumitalk-channel-state--inline {
  min-width: 0;
  width: 100%;
  align-self: start;
  display: flex;
  justify-content: flex-end;
  margin-top: -2px;
}

.lumitalk-channel-state time,
.lumitalk-state-text {
  color: var(--theme-text-soft);
  font-size: 8px;
  line-height: 1.1;
  font-weight: 700;
  white-space: nowrap;
}

.lumitalk-unread-badge {
  width: 18px;
  height: 18px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  margin-top: 7px;
  background: var(--theme-point);
  color:#fff;
  font-size:9px;
  line-height:1;
}

.lumitalk-empty {
  padding: 24px 16px;
  color: var(--theme-text-soft);
  font-size: 11px;
  line-height: 1.5;
  text-align: center;
  font-weight: 700;
}

/* Channel detail shell */
.lumitalk-detail {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100%;
  min-height: 0;
  overflow: hidden;
  background: var(--theme-bg);
}

.lumitalk-detail-header {
  flex: 0 0 auto;
  min-height: 84px;
  display: grid;
  grid-template-columns: 44px minmax(0,1fr) 44px;
  align-items: center;
  gap: 10px;
  padding: 12px;
  border-bottom: 1px solid var(--theme-line);
  background: var(--theme-bg);
}

.lumitalk-detail-nav {
  width:44px;
  height:44px;
  display:grid;
  place-items:center;
  border:1px solid var(--theme-line);
  border-radius:50%;
  background:rgba(255,255,255,.6);
  color:var(--theme-text-soft);
  font-size:24px;
  line-height:1;
  cursor:pointer;
}

.lumitalk-detail-nav--more {
  font-size:18px;
  letter-spacing:1px;
}

.lumitalk-detail-channel {
  min-width:0;
  display:grid;
  grid-template-columns:56px minmax(0,1fr);
  align-items:center;
  gap:12px;
}

.lumitalk-image-slot--detail-channel,
.lumitalk-image-slot--detail-member,
.lumitalk-image-slot--detail-help {
  width:56px;
  height:56px;
}

.lumitalk-detail-copy strong {
  display:block;
  overflow:hidden;
  color:var(--theme-text);
  font-size:18px;
  line-height:1.2;
  font-weight:900;
  letter-spacing:-.055em;
  text-overflow:ellipsis;
  white-space:nowrap;
}

.lumitalk-detail-copy p {
  margin:4px 0 0;
  overflow:hidden;
  color:var(--theme-text-soft);
  font-size:11px;
  line-height:1.35;
  font-weight:800;
  text-overflow:ellipsis;
  white-space:nowrap;
}

.lumitalk-detail-scroll {
  min-height:0;
  flex:1 1 auto;
  overflow-y:auto;
  overflow-x:hidden;
  overscroll-behavior:contain;
  padding:0 0 14px;
}

.lumitalk-detail-scroll::-webkit-scrollbar { display:none; }

.lumitalk-detail-intro {
  margin:18px 16px 0;
  padding:18px 18px 16px;
  border:1px solid var(--theme-line);
  border-radius:var(--theme-radius-lg);
  background:var(--theme-card);
}

.lumitalk-detail-kicker {
  display:block;
  margin-bottom:8px;
  color:var(--theme-point-deep);
  font-size:11px;
  line-height:1;
  font-weight:900;
  letter-spacing:.14em;
}

.lumitalk-detail-intro p {
  margin:0;
  color:var(--theme-text);
  font-size:12px;
  line-height:1.7;
  font-weight:700;
}

.lumitalk-detail-day-row {
  display:flex;
  justify-content:center;
  width:100%;
  margin:14px 0 0;
}

.lumitalk-detail-day {
  min-height:38px;
  display:inline-flex;
  align-items:center;
  justify-content:center;
  max-width:calc(100% - 32px);
  padding:0 15px;
  border:1px solid var(--theme-line);
  border-radius:999px;
  background:var(--theme-card);
  color:var(--theme-text-soft);
  font-size:10px;
  line-height:1;
  font-weight:900;
  white-space:nowrap;
}

.lumitalk-detail-notice {
  margin:12px 16px 0;
  padding:10px 13px;
  border:1px solid var(--theme-line);
  border-radius:999px;
  background:var(--theme-card);
  color:var(--theme-text-soft);
  font-size:10px;
  line-height:1.45;
  font-weight:800;
  text-align:center;
}

.lumitalk-thread {
  display:block;
  margin:18px 0 0;
  padding:0 16px 18px;
}

.lumitalk-thread-item { margin:0; }
.lumitalk-thread-item + .lumitalk-thread-item { margin-top:22px; }

.lumitalk-thread-head {
  display:flex;
  align-items:flex-start;
  gap:9px;
}

.lumitalk-image-slot--member-detail {
  width:42px;
  height:42px;
  flex:0 0 42px;
}

.lumitalk-thread-copy strong {
  display:block;
  margin:2px 0 6px;
  color:var(--theme-text);
  font-size:13px;
  line-height:1.15;
  font-weight:900;
  letter-spacing:-.055em;
}

.lumitalk-member-bubble,
.lumitalk-fan-bubble {
  max-width:100%;
  border-radius:18px;
  box-shadow:none;
}

.lumitalk-member-bubble {
  padding:13px 15px;
  border:1px solid rgba(232,199,213,.72);
  background:#fff;
}

.lumitalk-member-bubble p,
.lumitalk-fan-bubble p {
  margin:0;
  color:var(--theme-text);
  font-size:12px;
  line-height:1.62;
  font-weight:700;
  white-space:pre-wrap;
  word-break:break-word;
  overflow-wrap:anywhere;
}

.lumitalk-media-grid {
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:7px;
  margin-top:9px;
}

.lumitalk-media-slot {
  aspect-ratio:1/1;
  display:block;
  width:100%;
  padding:0;
  border:1px solid var(--theme-line);
  border-radius:13px;
  background:rgba(255,255,255,.55);
  cursor:pointer;
  -webkit-tap-highlight-color:transparent;
}

.lumitalk-message-actions {
  display:flex;
  flex-wrap:wrap;
  gap:5px;
  margin-top:8px;
}

.lumitalk-react-chip,
.lumitalk-action-chip {
  min-height:27px;
  padding:0 9px;
  border-radius:999px;
  font-size:9px;
}

.lumitalk-react-chip--more,
.lumitalk-action-chip {
  background:rgba(255,255,255,.9);
  cursor:pointer;
}

.lumitalk-action-chip.is-active {
  border-color:#d7b4c2;
  background:#faf2f5;
  color:#9e6679;
}

.lumitalk-thread-time {
  display:block;
  margin-top:6px;
  color:var(--theme-text-soft);
  font-size:9px;
  line-height:1.1;
  font-weight:700;
}

.lumitalk-thread-item--fan {
  display:grid;
  justify-items:end;
  padding-left:58px;
}

.lumitalk-fan-bubble {
  width:fit-content;
  max-width:min(100%, 74%);
  padding:13px 15px;
  border:1px solid #edc9d4;
  background:#ffe5f0;
}

.lumitalk-thread-time--fan {
  margin-right:2px;
  text-align:right;
}

.lumitalk-thread-item--system { display:grid; }

.lumitalk-system-bubble {
  padding:14px 16px;
  border:1px solid var(--theme-line);
  border-radius:var(--theme-radius-lg);
  background:var(--theme-card);
  color:var(--theme-text-soft);
  font-size:11px;
  line-height:1.6;
  font-weight:800;
  text-align:center;
}

/* Single composer definition */
.lumitalk-composer {
  flex:0 0 auto;
  display:grid;
  gap:7px;
  margin:0;
  padding:10px 16px 12px;
  border:0;
  border-radius:0;
  background:rgba(255,253,253,.98);
  box-shadow:none;
}

.lumitalk-composer-row {
  display:grid;
  grid-template-columns:minmax(0,1fr) 58px;
  gap:10px;
  align-items:flex-end;
}

.lumitalk-composer-input {
  width:100%;
  min-width:0;
  box-sizing:border-box;
  font-family: inherit;
  letter-spacing: -.03em;
  min-height:46px;
  max-height:170px;
  padding:12px 16px;
  border:1px solid var(--theme-line);
  border-radius:24px;
  background:rgba(255,255,255,.9);
  color:var(--theme-text);
  font-size:11px;
  line-height:1.5;
  font-weight:700;
  resize:none;
  overflow-x:hidden;
  overflow-y:hidden;
  scrollbar-width:none;
}

.lumitalk-composer-input::-webkit-scrollbar { display:none; }
.lumitalk-composer-input::placeholder { color:#b699a6; font-family:inherit; letter-spacing:inherit; opacity:1; }

.lumitalk-composer-submit {
  width:58px;
  height:58px;
  border:0;
  border-radius:50%;
  background:var(--theme-point);
  color:#fff;
  font-size:12px;
  line-height:1;
  font-weight:900;
  cursor:pointer;
}

.lumitalk-composer-input:disabled,
.lumitalk-composer-submit:disabled { cursor:default; opacity:.6; }

.lumitalk-composer p {
  margin:0;
  color:var(--theme-text-soft);
  font-size:9px;
  line-height:1.45;
  font-weight:700;
  text-align:center;
}

/* Reaction bottom sheet */
.lumitalk-sheet-backdrop {
  position:absolute;
  inset:0;
  z-index:30;
  display:flex;
  align-items:flex-end;
  background:rgba(45, 26, 37, .18);
}

.lumitalk-sheet {
  width:100%;
  max-height:min(72%, 620px);
  overflow:auto;
  padding:10px 16px 18px;
  border-radius:24px 24px 0 0;
  background:#fff;
  box-shadow:0 -12px 32px rgba(61, 33, 48, .14);
}

.lumitalk-sheet-handle {
  width:46px;
  height:4px;
  margin:2px auto 14px;
  border-radius:999px;
  background:#d6c4cb;
}

.lumitalk-sheet-head h3 {
  margin:0;
  color:var(--theme-text);
  font-size:16px;
  line-height:1.2;
  font-weight:900;
}

.lumitalk-sheet-head p {
  margin:6px 0 0;
  color:var(--theme-text-soft);
  font-size:11px;
  line-height:1.45;
  font-weight:700;
}

.lumitalk-sheet-search {
  margin:14px 0 18px;
  padding:0 14px;
  height:44px;
  display:flex;
  align-items:center;
  border-radius:14px;
  background:#f3f6fa;
  color:#a7b0bb;
  font-size:12px;
  font-weight:700;
}

.lumitalk-sheet-section + .lumitalk-sheet-section {
  margin-top:18px;
}

.lumitalk-sheet-section h4 {
  margin:0 0 10px;
  color:var(--theme-text);
  font-size:12px;
  line-height:1.2;
  font-weight:900;
}

.lumitalk-sheet-grid,
.lumitalk-sheet-summary-grid {
  display:grid;
  grid-template-columns:repeat(6, minmax(0, 1fr));
  gap:10px;
}

.lumitalk-sheet-emoji,
.lumitalk-sheet-summary-item {
  min-height:48px;
  border:0;
  border-radius:14px;
  background:#fff;
}

.lumitalk-sheet-emoji {
  display:grid;
  place-items:center;
  font-size:28px;
  line-height:1;
  cursor:pointer;
}

.lumitalk-sheet-summary-item {
  display:grid;
  justify-items:center;
  align-content:center;
  gap:4px;
  border:1px solid #f0dfe6;
  background:#fffafd;
}

.lumitalk-sheet-summary-emoji {
  font-size:24px;
  line-height:1;
}

.lumitalk-sheet-summary-item b {
  color:var(--theme-point-deep);
  font-size:11px;
  line-height:1;
}

.lumitalk-sheet-empty {
  margin:0;
  color:var(--theme-text-soft);
  font-size:11px;
  line-height:1.45;
  font-weight:700;
}

.lumitalk-tab:focus:not(:focus-visible),
.lumitalk-detail-nav:focus:not(:focus-visible),
.lumitalk-action-chip:focus:not(:focus-visible),
.lumitalk-react-chip:focus:not(:focus-visible),
.lumitalk-composer-submit:focus:not(:focus-visible),
.lumitalk-sheet-emoji:focus:not(:focus-visible) { outline:none; }


/* Emoji category bar inside reaction sheet */
.lumitalk-sheet {
  display:flex;
  flex-direction:column;
  overscroll-behavior:contain;
}

.lumitalk-sheet-section {
  padding-bottom:74px;
}

.lumitalk-sheet-category-bar {
  position:sticky;
  bottom:-18px;
  z-index:2;
  display:grid;
  grid-template-columns:repeat(7, minmax(0, 1fr));
  gap:2px;
  margin:14px -16px -18px;
  padding:10px 14px 12px;
  border-top:1px solid #f0e4e9;
  background:rgba(255,255,255,.98);
}

.lumitalk-sheet-category {
  min-width:0;
  height:38px;
  display:grid;
  place-items:center;
  border:0;
  border-radius:10px;
  background:transparent;
  color:#8f8790;
  font-size:21px;
  line-height:1;
  cursor:pointer;
}

.lumitalk-sheet-category.is-active {
  background:#f3f6fa;
  color:var(--theme-point-deep);
}

@media (max-width: 400px) {
  .lumitalk-detail-copy strong {
    font-size: 17px;
  }

  .lumitalk-thread-item--fan {
    padding-left: 42px;
  }

  .lumitalk-fan-bubble {
    max-width: min(100%, 82%);
  }

  .lumitalk-sheet-grid,
  .lumitalk-sheet-summary-grid {
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }
}


/* LUMI LETTER: a special member message inside the channel stream. */
.lumitalk-thread-item--letter {
  margin-left: 51px;
}

.lumitalk-letter {
  padding: 18px 18px 16px;
  border: 1px solid var(--theme-line);
  border-radius: var(--theme-radius-lg);
  background: var(--theme-card);
  box-shadow: 0 8px 18px rgba(130, 76, 99, .04);
}

.lumitalk-letter-kicker {
  display: block;
  color: var(--theme-point-deep);
  font-size: 11px;
  line-height: 1;
  font-weight: 900;
  letter-spacing: .08em;
}

.lumitalk-letter h4 {
  margin: 13px 0 7px;
  color: var(--theme-text);
  font-size: 13px;
  line-height: 1.3;
  font-weight: 500;
  letter-spacing: -.04em;
}

.lumitalk-letter p {
  margin: 0;
  color: var(--theme-text);
  font-size: 13px;
  line-height: 1.7;
  font-weight: 500;
  white-space: pre-wrap;
  word-break: break-word;
  overflow-wrap: anywhere;
}

.lumitalk-letter-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-top: 17px;
}

.lumitalk-letter-save {
  min-height: 34px;
  padding: 0 13px;
  border: 1px solid var(--theme-line);
  border-radius: 999px;
  background: rgba(255,255,255,.76);
  color: var(--theme-text-soft);
  font-family: inherit;
  font-size: 11px;
  line-height: 1;
  font-weight: 850;
  cursor: pointer;
}

.lumitalk-letter-save.is-saved {
  border-color: #d7b4c2;
  background: #faf2f5;
  color: #9e6679;
}

.lumitalk-letter-footer > span {
  color: var(--theme-text-soft);
  font-size: 10px;
  line-height: 1;
  font-weight: 700;
  white-space: nowrap;
}

@media (max-width: 400px) {
  .lumitalk-thread-item--letter { margin-left: 0; }
}

/* Channel more panel + media gallery */
.lumitalk-panel {
  display:flex;
  flex-direction:column;
  width:100%;
  height:100%;
  min-height:0;
  background:var(--theme-bg);
}

.lumitalk-panel-header {
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:12px;
  border-bottom:1px solid var(--theme-line);
  background:var(--theme-bg);
}

.lumitalk-panel-header-actions {
  display:flex;
  align-items:center;
  gap:8px;
}

.lumitalk-panel-header-icon,
.lumitalk-panel-gallery-like {
  width:34px;
  height:34px;
  display:grid;
  place-items:center;
  border:1px solid var(--theme-line);
  border-radius:50%;
  background:rgba(255,255,255,.7);
  color:var(--theme-point-deep);
  font-size:15px;
  line-height:1;
}

.lumitalk-panel-scroll {
  min-height:0;
  flex:1 1 auto;
  overflow-y:auto;
  overflow-x:hidden;
  padding:16px;
}

.lumitalk-panel-scroll::-webkit-scrollbar { display:none; }

.lumitalk-panel-hero,
.lumitalk-panel-card {
  border:1px solid var(--theme-line);
  border-radius:28px;
  background:rgba(255,255,255,.88);
  box-shadow:0 10px 24px rgba(130, 76, 99, .05);
}

.lumitalk-panel-hero {
  display:grid;
  justify-items:center;
  padding:22px 18px 20px;
}

.lumitalk-panel-avatar {
  width:128px;
  height:128px;
  display:block;
  border:1px solid var(--theme-line);
  border-radius:30px;
  background:linear-gradient(180deg, rgba(255,255,255,.95), rgba(252,239,246,.95));
}

.lumitalk-panel-hero h3 {
  margin:14px 0 0;
  color:var(--theme-text);
  font-size:28px;
  line-height:1.2;
  font-weight:900;
  letter-spacing:-.06em;
  text-align:center;
}

.lumitalk-panel-hero p {
  margin:8px 0 0;
  color:var(--theme-point);
  font-size:13px;
  line-height:1.3;
  font-weight:800;
  text-align:center;
}

.lumitalk-panel-card {
  margin-top:16px;
  padding:16px;
}

.lumitalk-panel-card--menu-list,
.lumitalk-panel-card--exit {
  padding:8px 12px;
}

.lumitalk-panel-media-head {
  width:100%;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
  padding:0;
  border:0;
  background:transparent;
  color:var(--theme-text);
  cursor:pointer;
}

.lumitalk-panel-media-head span {
  font-size:16px;
  line-height:1.2;
  font-weight:900;
  letter-spacing:-.05em;
}

.lumitalk-panel-media-head b {
  min-width:24px;
  min-height:24px;
  display:grid;
  place-items:center;
  padding:0 8px;
  border-radius:999px;
  background:#fff3f8;
  color:var(--theme-point-deep);
  font-size:10px;
  line-height:1;
  font-weight:900;
}

.lumitalk-panel-media-strip {
  display:grid;
  grid-template-columns:repeat(5, minmax(0, 1fr));
  gap:8px;
  margin-top:14px;
}

.lumitalk-panel-media-thumb {
  position:relative;
  overflow:hidden;
  border:1px solid var(--theme-line);
  border-radius:20px;
  background:rgba(255,255,255,.72);
}

.lumitalk-panel-media-thumb {
  aspect-ratio:1/1;
  padding:0;
  cursor:pointer;
}


.lumitalk-panel-menu-row {
  width:100%;
  display:grid;
  grid-template-columns:42px minmax(0,1fr) 20px;
  gap:12px;
  align-items:center;
  padding:16px 4px;
  border:0;
  border-bottom:1px dashed rgba(232,199,213,.9);
  background:transparent;
  text-align:left;
}

.lumitalk-panel-card--menu-list .lumitalk-panel-menu-row:last-child,
.lumitalk-panel-card--exit .lumitalk-panel-menu-row:last-child {
  border-bottom:0;
}

.lumitalk-panel-menu-icon {
  width:42px;
  height:42px;
  display:grid;
  place-items:center;
  border-radius:50%;
  background:#fff5f9;
  color:var(--theme-point-deep);
  font-size:18px;
  line-height:1;
}

.lumitalk-panel-menu-copy strong {
  display:block;
  color:var(--theme-text);
  font-size:14px;
  line-height:1.2;
  font-weight:900;
  letter-spacing:-.05em;
}

.lumitalk-panel-menu-copy small {
  display:block;
  margin-top:5px;
  color:var(--theme-text-soft);
  font-size:11px;
  line-height:1.45;
  font-weight:700;
}

.lumitalk-panel-menu-arrow {
  color:#d2a0b3;
  font-size:22px;
  line-height:1;
  font-weight:700;
}

.lumitalk-panel-menu-row.is-danger .lumitalk-panel-menu-copy strong,
.lumitalk-panel-card--exit .lumitalk-panel-menu-icon {
  color:var(--theme-point);
}

.lumitalk-panel-empty {
  padding:18px 12px;
  color:var(--theme-text-soft);
  font-size:11px;
  line-height:1.5;
  font-weight:700;
  text-align:center;
}

.lumitalk-detail-header--panel {
  grid-template-columns:44px minmax(0,1fr) 44px;
}

.lumitalk-detail-copy--panel p {
  margin-top:2px;
}

.lumitalk-detail-nav--heart {
  font-size:20px;
  color:var(--theme-point);
}

.lumitalk-panel-day-chip {
  width:fit-content;
  max-width:100%;
  min-height:36px;
  margin:0 auto 16px;
  padding:0 18px;
  display:flex;
  align-items:center;
  justify-content:center;
  border:1px solid var(--theme-line);
  border-radius:999px;
  background:rgba(255,255,255,.92);
  color:var(--theme-text-soft);
  font-size:11px;
  line-height:1;
  font-weight:900;
  letter-spacing:.02em;
}

.lumitalk-panel-gallery {
  display:grid;
  grid-template-columns:repeat(2, minmax(0, 1fr));
  gap:16px;
}

.lumitalk-panel-gallery-card,
.lumitalk-panel-gallery-card:nth-child(5n) {
  grid-column:auto;
}

.lumitalk-panel-gallery-art {
  position:relative;
  width:100%;
  aspect-ratio:.86 / 1;
  display:block;
  padding:0;
  overflow:hidden;
  border:1px solid var(--theme-line);
  border-radius:28px;
  background:rgba(255,255,255,.78);
  cursor:pointer;
}

.lumitalk-panel-gallery-art::before,
.lumitalk-panel-gallery-art::after {
  content:none;
}

@media (max-width: 400px) {
  .lumitalk-panel-hero h3 {
    font-size:24px;
  }


  .lumitalk-panel-gallery {
    gap:10px;
  }
}


/* Media gallery / viewer */
.lumitalk-panel-scroll--gallery {
  padding:14px 16px 24px;
}

.lumitalk-media-filter {
  width:calc(100% - 40px);
  max-width:520px;
  display:grid;
  grid-template-columns:repeat(3, minmax(0, 1fr));
  margin:0 auto 16px;
  overflow:hidden;
  border:1px solid var(--theme-line);
  border-radius:999px;
  background:rgba(255,255,255,.9);
}

.lumitalk-media-filter button {
  min-height:34px;
  padding:0 12px;
  border:0;
  border-right:1px solid rgba(232,199,213,.78);
  background:transparent;
  color:var(--theme-text-soft);
  font-family:inherit;
  font-size:10.5px;
  line-height:1;
  font-weight:850;
}

.lumitalk-media-filter button:last-child { border-right:0; }

.lumitalk-media-filter button.is-active {
  background:#fff6fa;
  color:var(--theme-point-deep);
}

.lumitalk-panel-gallery-slot {
  position:absolute;
  inset:0;
  display:block;
  border-radius:inherit;
  background:rgba(255,255,255,.68);
}

.lumitalk-panel-gallery-badge {
  position:absolute;
  left:14px;
  bottom:14px;
  min-width:64px;
  min-height:30px;
  padding:0 14px;
  border-radius:999px;
  display:inline-flex;
  align-items:center;
  justify-content:center;
  background:rgba(255,255,255,.94);
  color:var(--theme-text-soft);
  font-size:10px;
  font-weight:900;
}

.lumitalk-panel-gallery-time {
  position:absolute;
  right:54px;
  bottom:16px;
  min-width:48px;
  min-height:24px;
  padding:0 10px;
  border-radius:999px;
  display:inline-flex;
  align-items:center;
  justify-content:center;
  background:rgba(94,74,84,.72);
  color:#fff;
  font-size:10px;
  font-weight:800;
}

.lumitalk-panel-gallery-like {
  position:absolute;
  right:14px;
  bottom:14px;
  width:34px;
  height:34px;
  display:flex;
  align-items:center;
  justify-content:center;
  border-radius:50%;
  background:rgba(255,255,255,.95);
  color:var(--theme-point);
  font-size:18px;
  box-shadow:0 4px 10px rgba(120,88,104,.08);
}

.lumitalk-media-viewer {
  width:100%;
  min-height:100%;
  flex:1 1 auto;
  box-sizing:border-box;
  padding:14px 0 16px;
  background:#101010;
  color:#fff;
  display:flex;
  flex-direction:column;
  outline:0;
}

.lumitalk-media-viewer-header {
  position:relative;
  z-index:3;
  display:grid;
  grid-template-columns:42px minmax(0,1fr) 42px;
  align-items:center;
  gap:8px;
  padding:14px 14px 10px;
  transform:translateY(-10px);
  margin-bottom:-10px;
  transition:opacity .18s ease;
}

.lumitalk-media-viewer-back,
.lumitalk-media-viewer-more {
  width:42px;
  height:42px;
  padding:0;
  border:0;
  border-radius:50%;
  background:transparent;
  color:#fff;
  line-height:1;
  position:relative;
  z-index:4;
  pointer-events:auto;
}

.lumitalk-media-viewer-back {
  font-size:28px;
}

.lumitalk-media-viewer-more {
  justify-self:end;
  font-size:24px;
  font-weight:400;
  letter-spacing:0;
}

.lumitalk-media-viewer-copy {
  min-width:0;
}

.lumitalk-media-viewer-copy strong {
  display:block;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
  font-size:16px;
  line-height:1.2;
  font-weight:950;
  letter-spacing:-.04em;
}

.lumitalk-media-viewer-copy p {
  margin-top:2px;
  color:rgba(255,255,255,.72);
  font-size:11px;
  line-height:1.35;
  font-weight:800;
}

.lumitalk-media-viewer-body {
  flex:1;
  display:grid;
  grid-template-columns:42px minmax(0,1fr) 42px;
  align-items:center;
  gap:6px;
  padding:10px;
  touch-action:pan-y;
  transform:translateY(-44px);
  position:relative;
  z-index:2;
}

.lumitalk-media-viewer-side {
  position:relative;
  z-index:2;
  width:42px;
  height:42px;
  padding:0;
  border:0;
  border-radius:50%;
  background:rgba(255,255,255,.08);
  color:#fff;
  font-size:28px;
  display:flex;
  align-items:center;
  justify-content:center;
  transition:opacity .18s ease;
  position:relative;
  z-index:4;
  pointer-events:auto;
}

.lumitalk-media-viewer-stage {
  min-width:0;
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:13px;
  touch-action:pan-y;
}

.lumitalk-media-viewer-frame {
  width:100%;
  display:flex;
  justify-content:center;
}

.lumitalk-media-viewer-slot {
  width:min(100%, 41.333dvh);
  max-height:62dvh;
  aspect-ratio:2 / 3;
  border:1px solid rgba(255,255,255,.18);
  border-radius:24px;
  background:rgba(255,255,255,.055);
}

.lumitalk-media-viewer-caption {
  margin:0;
  text-align:center;
  font-size:13px;
  line-height:1.6;
  letter-spacing:.01em;
  transition:opacity .18s ease;
}

.lumitalk-media-viewer-actions {
  display:grid;
  grid-template-columns:repeat(3, minmax(0,1fr));
  gap:8px;
  margin-top:-38px;
  padding:0 16px 0;
  transition:opacity .18s ease;
}

.lumitalk-media-viewer-actions button {
  min-width:0;
  padding:10px 8px;
  border:1px solid rgba(255,255,255,.14);
  border-radius:999px;
  background:rgba(255,255,255,.08);
  color:#fff;
  font-family:inherit;
  font-size:12px;
  font-weight:950;
}

.lumitalk-media-viewer-page {
  width:auto;
  min-height:0;
  margin:8px auto 0;
  padding:6px 12px;
  border-radius:999px;
  display:flex;
  align-items:center;
  justify-content:center;
  background:rgba(255,255,255,.08);
  color:#fff;
  font-size:11px;
  font-weight:900;
  transition:opacity .18s ease;
}

.lumitalk-media-viewer.is-ui-hidden .lumitalk-media-viewer-header,
.lumitalk-media-viewer.is-ui-hidden .lumitalk-media-viewer-side,
.lumitalk-media-viewer.is-ui-hidden .lumitalk-media-viewer-caption,
.lumitalk-media-viewer.is-ui-hidden .lumitalk-media-viewer-actions,
.lumitalk-media-viewer.is-ui-hidden .lumitalk-media-viewer-page {
  opacity:0;
  pointer-events:none;
}

.lumitalk-media-viewer.is-ui-hidden .lumitalk-media-viewer-body {
  transform:translateY(0);
}

@media (max-width:400px) {
  .lumitalk-media-filter {
    width:calc(100% - 24px);
    margin-bottom:14px;
  }

  .lumitalk-media-filter button {
    min-height:32px;
    padding:0 10px;
    font-size:10px;
  }

}


.lumitalk-panel-scroll--settings {
  padding-top: 18px;
}

.lumitalk-settings-heading {
  margin: 0 0 16px;
  text-align: center;
}

.lumitalk-settings-heading h3 {
  margin: 0;
  color: var(--theme-text);
  font-size: 20px;
  line-height: 1.18;
  font-weight: 900;
  letter-spacing: -.06em;
}

.lumitalk-settings-heading p {
  margin: 6px 0 0;
  color: var(--theme-text-soft);
  font-size: 10.5px;
  line-height: 1.45;
  font-weight: 700;
}

.lumitalk-settings-hero,
.lumitalk-settings-card {
  border: 1px solid var(--theme-line);
  border-radius: 28px;
  background: rgba(255,255,255,.9);
  box-shadow: 0 10px 24px rgba(130, 76, 99, .05);
}

.lumitalk-settings-hero {
  display: grid;
  grid-template-columns: 98px minmax(0,1fr);
  gap: 16px;
  align-items: center;
  padding: 18px;
}

.lumitalk-settings-hero-slot,
.lumitalk-settings-row-slot {
  display: block;
  border: 1px solid var(--theme-line);
  background: linear-gradient(180deg, rgba(255,255,255,.96), rgba(252,239,246,.9));
}

.lumitalk-settings-hero-slot {
  width: 98px;
  height: 98px;
  border-radius: 26px;
}

.lumitalk-settings-hero-copy {
  min-width: 0;
}

.lumitalk-settings-hero-copy h4 {
  margin: 0;
  color: var(--theme-text);
  font-size: 18px;
  line-height: 1.24;
  font-weight: 900;
  letter-spacing: -.05em;
}

.lumitalk-settings-hero-copy p {
  margin: 8px 0 0;
  color: var(--theme-text-soft);
  font-size: 12px;
  line-height: 1.55;
  font-weight: 700;
}


.lumitalk-settings-card {
  margin-top: 16px;
  padding: 8px 12px;
}

.lumitalk-settings-row {
  width: 100%;
  display: grid;
  grid-template-columns: 48px minmax(0,1fr) 20px;
  gap: 14px;
  align-items: center;
  padding: 16px 6px;
  border: 0;
  border-bottom: 1px dashed rgba(232,199,213,.9);
  background: transparent;
  text-align: left;
}

.lumitalk-settings-card .lumitalk-settings-row:last-child {
  border-bottom: 0;
}

.lumitalk-settings-row-slot {
  width: 48px;
  height: 48px;
  border-radius: 16px;
}

.lumitalk-settings-row-copy {
  min-width: 0;
}

.lumitalk-settings-row-copy strong {
  display: block;
  color: var(--theme-text);
  font-size: 15px;
  line-height: 1.2;
  font-weight: 900;
  letter-spacing: -.05em;
}

.lumitalk-settings-row-copy small {
  display: block;
  margin-top: 5px;
  color: var(--theme-text-soft);
  font-size: 11px;
  line-height: 1.5;
  font-weight: 700;
}

.lumitalk-settings-card--exit .lumitalk-settings-row-copy strong {
  color: var(--theme-point);
}

@media (max-width: 400px) {
  .lumitalk-settings-heading h3 {
    font-size: 21px;
  }

  .lumitalk-settings-hero {
    grid-template-columns: 80px minmax(0,1fr);
    gap: 14px;
    padding: 16px;
  }

  .lumitalk-settings-hero-slot {
    width: 80px;
    height: 80px;
    border-radius: 22px;
  }

  .lumitalk-settings-hero-copy h4 {
    font-size: 16px;
  }

}


.lumitalk-settings-modal {
  position: sticky;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
}

.lumitalk-settings-modal-dim {
  position: fixed;
  inset: 0;
  width: 100%;
  height: 100%;
  padding: 0;
  border: 0;
  outline: 0;
  appearance: none;
  -webkit-appearance: none;
  background: rgba(36, 18, 26, .22);
  box-shadow: none;
}

.lumitalk-settings-modal-dim:focus,
.lumitalk-settings-modal-dim:focus-visible,
.lumitalk-settings-modal-dim:active {
  outline: 0;
  box-shadow: none;
}

.lumitalk-settings-modal-sheet {
  position: fixed;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: min(74%, 430px);
  padding: 18px 16px 16px;
  border: 1px solid var(--theme-line);
  border-radius: 28px;
  background: rgba(255,255,255,.97);
  box-shadow: 0 18px 36px rgba(82, 46, 62, .16);
}

.lumitalk-settings-modal-head {
  text-align: center;
}

.lumitalk-settings-modal-head h4 {
  margin: 0;
  color: var(--theme-text);
  font-size: 24px;
  line-height: 1.18;
  font-weight: 900;
  letter-spacing: -.06em;
}

.lumitalk-settings-modal-head p {
  margin: 8px 0 0;
  color: var(--theme-text-soft);
  font-size: 12px;
  line-height: 1.45;
  font-weight: 700;
}

.lumitalk-settings-name-preview {
  margin-top: 14px;
  display: grid;
  grid-template-columns: 52px minmax(0,1fr);
  gap: 12px;
  align-items: center;
  padding: 10px 12px;
  border: 1px solid var(--theme-line);
  border-radius: 16px;
  background: rgba(255,255,255,.92);
}

.lumitalk-settings-name-preview-slot,
.lumitalk-settings-field-side-slot,
.lumitalk-settings-reset-slot {
  display: block;
  border: 1px solid var(--theme-line);
  background: linear-gradient(180deg, rgba(255,255,255,.96), rgba(252,239,246,.9));
}

.lumitalk-settings-name-preview-slot {
  width: 52px;
  height: 52px;
  border-radius: 15px;
}

.lumitalk-settings-name-preview strong {
  color: var(--theme-text);
  font-size: 15px;
  line-height: 1.25;
  font-weight: 900;
  letter-spacing: -.05em;
}

.lumitalk-settings-field {
  display: block;
  margin-top: 14px;
}

.lumitalk-settings-field-label {
  display: block;
  margin-bottom: 6px;
  color: var(--theme-text);
  font-size: 14px;
  line-height: 1.2;
  font-weight: 900;
  letter-spacing: -.04em;
}

.lumitalk-settings-field-input-wrap {
  display: grid;
  grid-template-columns: minmax(0,1fr) 30px;
  gap: 10px;
  align-items: center;
  padding: 0 10px 0 12px;
  min-height: 48px;
  border: 1px solid var(--theme-line);
  border-radius: 15px;
  background: #fff;
}

.lumitalk-settings-field-input {
  width: 100%;
  min-width: 0;
  border: 0;
  outline: 0;
  background: transparent;
  color: var(--theme-text);
  font: inherit;
  font-size: 14px;
  line-height: 1.3;
  font-weight: 800;
}

.lumitalk-settings-field-side-slot {
  width: 22px;
  height: 22px;
  border-radius: 8px;
}

.lumitalk-settings-field-help {
  margin: 7px 0 0;
  color: var(--theme-point);
  font-size: 10px;
  line-height: 1.45;
  font-weight: 700;
}

.lumitalk-settings-reset {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 14px;
  min-height: 44px;
  padding: 0 12px;
  border: 1px dashed rgba(232,199,213,.95);
  border-radius: 15px;
  background: rgba(255,255,255,.9);
  color: var(--theme-text);
  font: inherit;
  font-size: 12px;
  font-weight: 800;
}

.lumitalk-settings-modal-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0,1fr));
  gap: 10px;
  margin-top: 14px;
}

.lumitalk-settings-modal-button {
  min-height: 48px;
  border: 1px solid var(--theme-line);
  border-radius: 15px;
  background: rgba(255,255,255,.95);
  color: var(--theme-text);
  font: inherit;
  font-size: 16px;
  line-height: 1.2;
  font-weight: 900;
}

.lumitalk-settings-modal-button.is-primary {
  background: rgba(248, 128, 173, .18);
  color: var(--theme-point);
}

@media (max-width: 400px) {
  .lumitalk-settings-modal-sheet {
    width: calc(100% - 56px);
    padding: 16px 14px 14px;
    border-radius: 24px;
  }

  .lumitalk-settings-modal-head h4 {
    font-size: 19px;
  }

  .lumitalk-settings-name-preview {
    grid-template-columns: 48px minmax(0,1fr);
    gap: 10px;
  }

  .lumitalk-settings-name-preview-slot {
    width: 48px;
    height: 48px;
    border-radius: 14px;
  }
}


.lumitalk-settings-modal-sheet--shortcut {
  max-width: 428px;
}

.lumitalk-settings-shortcut-preview {
  margin-top: 16px;
}

.lumitalk-settings-shortcut-frame {
  position: relative;
  min-height: 166px;
  padding: 22px 16px 16px;
  border: 1px solid var(--theme-line);
  border-radius: 22px;
  background: rgba(255,255,255,.92);
  text-align: center;
}

.lumitalk-settings-shortcut-icon,
.lumitalk-settings-shortcut-deco {
  display: block;
  border: 1px solid var(--theme-line);
  background: linear-gradient(180deg, rgba(255,255,255,.96), rgba(252,239,246,.9));
}

.lumitalk-settings-shortcut-icon {
  width: 62px;
  height: 62px;
  border-radius: 19px;
  margin: 0 auto 10px;
}

.lumitalk-settings-shortcut-frame strong {
  display: block;
  color: var(--theme-text);
  font-size: 16px;
  line-height: 1.2;
  font-weight: 900;
  letter-spacing: -.05em;
}

.lumitalk-settings-shortcut-frame small {
  display: block;
  margin-top: 6px;
  color: var(--theme-point);
  font-size: 12px;
  line-height: 1.2;
  font-weight: 800;
}

.lumitalk-settings-shortcut-help {
  margin: 14px 0 0;
  color: var(--theme-point);
  font-size: 12px;
  line-height: 1.45;
  font-weight: 700;
  text-align: center;
}

@media (max-width: 400px) {
  .lumitalk-settings-modal-sheet--shortcut {
    max-width: none;
  }

  .lumitalk-settings-shortcut-frame {
    min-height: 154px;
    padding: 18px 12px 14px;
  }

  .lumitalk-settings-shortcut-icon {
    width: 56px;
    height: 56px;
    border-radius: 18px;
  }

  .lumitalk-settings-shortcut-frame strong {
    font-size: 15px;
  }
}


.lumitalk-settings-toast {
  position: fixed;
  left: 50%;
  bottom: 26px;
  z-index: 30;
  width: min(calc(100% - 40px), 360px);
  transform: translateX(-50%);
  padding: 13px 16px;
  border: 1px solid var(--theme-line);
  border-radius: 16px;
  background: rgba(255,255,255,.96);
  box-shadow: 0 12px 24px rgba(82, 46, 62, .14);
  color: var(--theme-text);
  font-size: 12px;
  line-height: 1.45;
  font-weight: 800;
  text-align: center;
}

/* LumiTalk background settings: compact clean layout */
.lumitalk-panel--background {
  min-height: 100%;
}

.lumitalk-background-header {
  min-height: 62px;
  display: flex;
  align-items: center;
  padding: 0 14px;
  border-bottom: 1px solid var(--theme-line);
}

.lumitalk-panel-scroll--background {
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding: 14px 14px 22px;
}

.lumitalk-background-heading {
  padding: 2px 0 0;
  text-align: center;
}

.lumitalk-background-heading h3,
.lumitalk-background-heading p,
.lumitalk-background-channel h4,
.lumitalk-background-channel p,
.lumitalk-background-note strong,
.lumitalk-background-note p {
  margin: 0;
}

.lumitalk-background-heading h3 {
  color: var(--theme-text);
  font-size: 18px;
  line-height: 1.2;
  font-weight: 900;
  letter-spacing: -.05em;
}

.lumitalk-background-heading p {
  margin-top: 6px;
  color: var(--theme-text-soft);
  font-size: 11px;
  line-height: 1.45;
  font-weight: 700;
}

.lumitalk-background-channel,
.lumitalk-background-picker,
.lumitalk-background-note {
  border: 1px solid var(--theme-line);
  border-radius: 22px;
  background: rgba(255,255,255,.92);
}

.lumitalk-background-channel {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 14px;
}

.lumitalk-background-channel-slot {
  display: block;
  width: 54px;
  height: 54px;
  flex: 0 0 auto;
  border: 1px solid var(--theme-line);
  border-radius: 50%;
  background: linear-gradient(180deg, rgba(255,255,255,.98), rgba(252,239,246,.92));
}

.lumitalk-background-channel h4 {
  color: var(--theme-text);
  font-size: 15px;
  line-height: 1.3;
  font-weight: 900;
  letter-spacing: -.04em;
}

.lumitalk-background-channel p {
  margin-top: 4px;
  color: var(--theme-point);
  font-size: 11px;
  line-height: 1.35;
  font-weight: 800;
}

.lumitalk-background-picker {
  padding: 12px;
}

.lumitalk-background-section-title {
  margin-bottom: 10px;
}

.lumitalk-background-section-title strong {
  color: var(--theme-text);
  font-size: 14px;
  line-height: 1.2;
  font-weight: 900;
  letter-spacing: -.04em;
}

.lumitalk-background-preview-slot {
  position: relative;
  min-height: 138px;
  overflow: hidden;
  border: 1px solid var(--theme-line);
  border-radius: 18px;
  background: linear-gradient(180deg, rgba(255,255,255,.98), rgba(252,239,246,.92));
}

.lumitalk-background-preview-day {
  position: absolute;
  top: 12px;
  left: 50%;
  transform: translateX(-50%);
  min-height: 22px;
  padding: 0 12px;
  border-radius: 999px;
  background: rgba(247,220,230,.92);
  color: var(--theme-text-soft);
  font-size: 11px;
  line-height: 22px;
  font-weight: 800;
}

.lumitalk-background-preview-chatrow {
  position: absolute;
  left: 16px;
  right: 18px;
  bottom: 42px;
  display: flex;
  align-items: flex-end;
  gap: 8px;
}

.lumitalk-background-preview-profile {
  width: 46px;
  height: 46px;
  flex: 0 0 auto;
  border: 1px solid var(--theme-line);
  border-radius: 50%;
  background: linear-gradient(180deg, rgba(255,255,255,.98), rgba(252,239,246,.92));
}

.lumitalk-background-preview-message {
  display: inline-flex;
  align-items: center;
  min-width: 0;
  max-width: calc(100% - 120px);
  padding: 10px 16px;
  border: 1px solid var(--theme-line);
  border-radius: 18px;
  background: rgba(255,255,255,.96);
  color: var(--theme-text);
  font-size: 13px;
  line-height: 1.35;
  font-weight: 800;
}

.lumitalk-background-preview-time {
  flex: 0 0 auto;
  margin-left: 2px;
  padding-bottom: 4px;
  white-space: nowrap;
  color: var(--theme-point);
  font-size: 10px;
  line-height: 1.2;
  font-weight: 700;
}

.lumitalk-bg-tabs {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  margin-top: 12px;
  overflow: hidden;
  border: 1px solid var(--theme-line);
  border-radius: 999px;
}

.lumitalk-bg-tab {
  min-height: 40px;
  border: 0;
  border-right: 1px solid var(--theme-line);
  background: rgba(255,255,255,.9);
  color: var(--theme-text-soft);
  font-size: 13px;
  line-height: 1.2;
  font-weight: 800;
}

.lumitalk-bg-tab:last-child {
  border-right: 0;
}

.lumitalk-bg-tab.is-active {
  background: rgba(250,232,239,.96);
  color: var(--theme-accent);
}

.lumitalk-bg-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10px;
  margin-top: 12px;
}

.lumitalk-bg-tile {
  position: relative;
  display: block;
  width: 100%;
  padding: 0;
  aspect-ratio: 1 / 1;
  overflow: hidden;
  appearance: none;
  -webkit-appearance: none;
  outline: none;
  border: 1px solid rgba(245,201,214,.95);
  border-radius: 16px;
  background: linear-gradient(180deg, rgba(255,255,255,.98), rgba(252,239,246,.92));
  -webkit-tap-highlight-color: transparent;
}

.lumitalk-bg-tile.is-selected {
  border-width: 2px;
  border-color: rgba(244,128,170,.92);
  box-shadow: inset 0 0 0 1px rgba(255,255,255,.75);
}

.lumitalk-bg-tile:focus,
.lumitalk-bg-tile:active {
  outline: none;
  box-shadow: none;
}

.lumitalk-bg-tile:focus-visible {
  outline: none;
  box-shadow: 0 0 0 2px rgba(244,128,170,.16);
}

.lumitalk-bg-tile-check {
  position: absolute;
  top: 8px;
  right: 8px;
  width: 24px;
  height: 24px;
  border-radius: 50%;
  border: 1px solid rgba(245,201,214,.95);
  background: rgba(255,255,255,.94);
  opacity: 0;
  pointer-events: none;
}

.lumitalk-bg-tile.is-selected .lumitalk-bg-tile-check {
  border-color: rgba(221,104,150,.95);
  background: rgba(244,128,170,.94);
  opacity: 1;
}

.lumitalk-bg-tile.is-selected .lumitalk-bg-tile-check::before {
  content: '';
  position: absolute;
  left: 8px;
  top: 4px;
  width: 6px;
  height: 11px;
  border-right: 2px solid #fff;
  border-bottom: 2px solid #fff;
  transform: rotate(45deg);
}

.lumitalk-bg-current {
  position: absolute;
  left: 8px;
  bottom: 8px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 64px;
  min-height: 24px;
  padding: 0 10px;
  border-radius: 999px;
  background: rgba(244,128,170,.94);
  color: #fff;
  font-size: 10px;
  line-height: 1.2;
  font-weight: 800;
  text-align: center;
}

.lumitalk-background-note {
  padding: 14px;
}

.lumitalk-background-note strong {
  display: block;
  color: var(--theme-text);
  font-size: 15px;
  line-height: 1.24;
  font-weight: 900;
  letter-spacing: -.04em;
}

.lumitalk-background-note p {
  margin-top: 6px;
  color: var(--theme-text-soft);
  font-size: 11px;
  line-height: 1.5;
  font-weight: 700;
}

.lumitalk-background-apply {
  width: 100%;
  min-height: 44px;
  border: 1px solid var(--theme-accent);
  border-radius: 999px;
  background: rgba(244,128,170,.94);
  color: #fff;
  font-size: 14px;
  line-height: 1.2;
  font-weight: 900;
  letter-spacing: -.04em;
}

@media (max-width: 400px) {
  .lumitalk-background-header {
    min-height: 58px;
    padding: 0 12px;
  }

  .lumitalk-panel-scroll--background {
    gap: 10px;
    padding: 12px 12px 20px;
  }

  .lumitalk-background-heading h3 {
    font-size: 17px;
  }

  .lumitalk-background-heading p {
    font-size: 10px;
  }

  .lumitalk-background-channel {
    gap: 10px;
    padding: 12px;
    border-radius: 20px;
  }

  .lumitalk-background-channel-slot {
    width: 48px;
    height: 48px;
  }

  .lumitalk-background-channel h4 {
    font-size: 14px;
  }

  .lumitalk-background-channel p {
    font-size: 10px;
  }

  .lumitalk-background-picker,
  .lumitalk-background-note {
    padding: 12px;
    border-radius: 20px;
  }

  .lumitalk-background-section-title strong {
    font-size: 13px;
  }

  .lumitalk-background-preview-slot {
    min-height: 128px;
    border-radius: 16px;
  }

  .lumitalk-background-preview-day {
    top: 11px;
    min-height: 20px;
    font-size: 10px;
    line-height: 20px;
  }

  .lumitalk-background-preview-chatrow {
    left: 14px;
    right: 16px;
    bottom: 38px;
    gap: 7px;
  }

  .lumitalk-background-preview-profile {
    width: 42px;
    height: 42px;
  }

  .lumitalk-background-preview-message {
    max-width: calc(100% - 108px);
    padding: 9px 13px;
    border-radius: 17px;
    font-size: 12px;
  }

  .lumitalk-background-preview-time {
    margin-left: 1px;
    padding-bottom: 4px;
    font-size: 10px;
  }

  .lumitalk-bg-tab {
    min-height: 38px;
    font-size: 12px;
  }

  .lumitalk-bg-grid {
    gap: 8px;
  }

  .lumitalk-bg-tile {
    border-radius: 15px;
  }

  .lumitalk-bg-tile-check {
    top: 7px;
    right: 7px;
    width: 22px;
    height: 22px;
  }

  .lumitalk-bg-tile.is-selected .lumitalk-bg-tile-check::before {
    left: 7px;
    top: 4px;
    width: 5px;
    height: 10px;
  }

  .lumitalk-bg-current {
    left: 7px;
    bottom: 7px;
    min-width: 58px;
    min-height: 22px;
    font-size: 9px;
  }

  .lumitalk-background-note strong {
    font-size: 14px;
  }

  .lumitalk-background-note p {
    font-size: 10px;
  }

  .lumitalk-background-apply {
    min-height: 42px;
    font-size: 13px;
  }
}



/* LumiTalk profile home: fan-facing member profile layout */
.lumitalk-panel--profile-home {
  min-height: 100%;
  background: var(--theme-bg);
}

.lumitalk-panel-scroll--profile-home {
  display: flex;
  flex-direction: column;
  gap: 0;
  min-height: 100%;
  padding: 0 0 24px;
  background: linear-gradient(180deg, #fffafb 0%, #fff5f8 36%, #f9dfeb 58%, #efaeca 77%, #d66b93 100%);
}

.lumitalk-profile-home-hero {
  position: relative;
  isolation: isolate;
  overflow: visible;
  margin-bottom: -54px;
  padding: clamp(356px, calc(112vw - 64px), 626px) 16px 78px;
  background: transparent;
}

.lumitalk-profile-home-hero::after {
  content: none;
}

.lumitalk-profile-home-cover-slot {
  position: absolute;
  z-index: -2;
  inset: 0;
  display: block;
  width: 100%;
  height: 100%;
  margin: 0;
  border: 0;
  background: transparent;
  background-position: center;
  background-repeat: no-repeat;
  background-size: cover;
}

.lumitalk-profile-home-hero-nav {
  position: absolute;
  z-index: 1;
  top: 14px;
  left: 16px;
  right: 16px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.lumitalk-profile-home-hero-actions {
  display: flex;
  gap: 8px;
}

.lumitalk-profile-home-nav-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 42px;
  height: 42px;
  padding: 0;
  border: 1px solid rgba(255,255,255,.76);
  border-radius: 50%;
  background: rgba(255,255,255,.9);
  color: var(--theme-point-deep);
  font: inherit;
  font-size: 20px;
  line-height: 1;
  font-weight: 900;
}

.lumitalk-profile-home-hero-actions .lumitalk-profile-home-nav-button:last-child {
  font-size: 15px;
  letter-spacing: .08em;
}

.lumitalk-profile-home-identity {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-end;
  gap: 12px;
}

.lumitalk-profile-home-avatar-slot {
  display: block;
  width: 92px;
  height: 92px;
  flex: 0 0 auto;
  border: 3px solid #fff;
  border-radius: 50%;
  box-shadow: 0 0 0 1px rgba(255,255,255,.72);
  background: linear-gradient(180deg, rgba(255,255,255,.98), rgba(252,239,246,.92));
}

.lumitalk-profile-home-copy {
  min-width: 0;
  padding-bottom: 7px;
}

.lumitalk-profile-home-copy h3,
.lumitalk-profile-home-copy p {
  margin: 0;
}

.lumitalk-profile-home-copy h3 {
  color: #fff;
  font-size: 25px;
  line-height: 1.1;
  font-weight: 900;
  letter-spacing: -.06em;
  text-shadow: 0 1px 7px rgba(58,22,34,.42);
}

.lumitalk-profile-home-copy p {
  margin-top: 8px;
  color: rgba(255,255,255,.92);
  font-size: 12px;
  line-height: 1.45;
  font-weight: 750;
  text-shadow: 0 1px 6px rgba(58,22,34,.36);
}

.lumitalk-profile-home-actions {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
  margin-top: 22px;
  padding: 0 4px;
}

.lumitalk-profile-home-actions button {
  min-height: 44px;
  padding: 0 12px;
  border: 1px solid rgba(255,255,255,.76);
  border-radius: 16px;
  background: rgba(255,255,255,.92);
  color: var(--theme-point);
  font: inherit;
  font-size: 12px;
  line-height: 1.2;
  font-weight: 900;
  letter-spacing: -.04em;
}

.lumitalk-profile-home-gallery {
  position: relative;
  z-index: 2;
  margin: 6px 12px 0;
  padding: 18px 18px 20px;
  border: 1px solid rgba(255,255,255,.86);
  border-radius: 26px;
  background: rgba(255,255,255,.96);
  box-shadow: 0 10px 26px rgba(203,111,147,.18);
}

.lumitalk-profile-home-gallery::before {
  content: '';
  position: absolute;
  inset: 8px;
  border: 1px solid rgba(240,214,224,.95);
  border-radius: 20px;
  pointer-events: none;
}

.lumitalk-profile-home-gallery-head {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding: 2px 2px 0;
}

.lumitalk-profile-home-gallery-head strong {
  color: var(--theme-text);
  font-size: 16px;
  line-height: 1.25;
  font-weight: 900;
  letter-spacing: -.05em;
}

.lumitalk-profile-home-gallery-head button {
  padding: 0;
  border: 0;
  background: transparent;
  color: var(--theme-point);
  font: inherit;
  font-size: 11px;
  line-height: 1.2;
  font-weight: 800;
}

.lumitalk-profile-home-gallery-grid {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10px;
  margin-top: 16px;
}

.lumitalk-profile-home-gallery-slot {
  display: block;
  aspect-ratio: .78 / 1;
  border: 1px solid var(--theme-line);
  border-radius: 18px;
  background: linear-gradient(180deg, rgba(255,255,255,.98), rgba(252,239,246,.92));
}

.lumitalk-profile-home-gallery-intro {
  position: relative;
  z-index: 1;
  margin: 18px auto 4px;
  max-width: 88%;
  color: var(--theme-text-soft);
  font-size: 12px;
  line-height: 1.7;
  font-weight: 700;
  text-align: center;
}

@media (max-width: 400px) {
  .lumitalk-panel-scroll--profile-home {
    padding-bottom: 20px;
  }

  .lumitalk-profile-home-hero {
    margin-bottom: -48px;
    padding: clamp(314px, calc(108vw - 56px), 414px) 14px 68px;
  }

  .lumitalk-profile-home-hero-nav {
    top: 12px;
    left: 14px;
    right: 14px;
  }

  .lumitalk-profile-home-nav-button {
    width: 38px;
    height: 38px;
  }

  .lumitalk-profile-home-identity {
    gap: 10px;
  }

  .lumitalk-profile-home-avatar-slot {
    width: 82px;
    height: 82px;
  }

  .lumitalk-profile-home-copy h3 {
    font-size: 22px;
  }

  .lumitalk-profile-home-copy p {
    margin-top: 7px;
    font-size: 11px;
  }

  .lumitalk-profile-home-actions {
    gap: 8px;
    margin-top: 20px;
    padding: 0 2px;
  }

  .lumitalk-profile-home-actions button {
    min-height: 42px;
    font-size: 11px;
  }

  .lumitalk-profile-home-gallery {
    margin: 6px 10px 0;
    padding: 16px 16px 18px;
    border-radius: 24px;
  }

  .lumitalk-profile-home-gallery::before {
    inset: 7px;
    border-radius: 18px;
  }

  .lumitalk-profile-home-gallery-grid {
    gap: 8px;
    margin-top: 14px;
  }

  .lumitalk-profile-home-gallery-slot {
    border-radius: 16px;
  }

  .lumitalk-profile-home-gallery-intro {
    max-width: 92%;
    margin-top: 16px;
    font-size: 11px;
  }
}

/* LumiTalk personal-channel leave / rejoin */
.lumitalk-settings-modal--leave .lumitalk-settings-modal-dim {
  background: rgba(61, 31, 45, .28);
}

.lumitalk-settings-modal-sheet--leave {
  width: min(82%, 430px);
  padding: 24px 22px 20px;
  border: 1px solid rgba(244, 190, 208, .92);
  border-radius: 30px;
  background: rgba(255, 253, 253, .98);
  box-shadow: 0 18px 44px rgba(79, 34, 53, .22);
}

.lumitalk-settings-modal-head--leave h4 {
  color: var(--theme-text);
  font-size: 20px;
  line-height: 1.28;
  letter-spacing: -.055em;
}

.lumitalk-settings-modal-head--leave p {
  margin-top: 10px;
  color: var(--theme-text-soft);
  font-size: 12px;
  line-height: 1.58;
}

.lumitalk-settings-modal-actions--leave {
  gap: 12px;
  margin-top: 20px;
}

.lumitalk-settings-modal-actions--leave .lumitalk-settings-modal-button {
  min-height: 50px;
  border-radius: 17px;
  font-size: 16px;
}

.lumitalk-settings-modal-button.is-danger {
  background: rgba(244,128,170,.94);
  border-color: rgba(244,128,170,.94);
  color: #fff;
}

@media (max-width: 400px) {
  .lumitalk-settings-modal-sheet--leave {
    width: calc(100% - 48px);
    padding: 22px 18px 18px;
    border-radius: 27px;
  }

  .lumitalk-settings-modal-head--leave h4 {
    font-size: 18px;
  }

  .lumitalk-settings-modal-head--leave p {
    font-size: 11px;
  }

  .lumitalk-settings-modal-actions--leave .lumitalk-settings-modal-button {
    min-height: 48px;
    font-size: 15px;
  }
}

.lumitalk-profile-home-join {
  position: relative;
  z-index: 2;
  margin: 8px 12px 0;
  padding: 18px 16px 18px;
  border: 1px solid rgba(255,255,255,.88);
  border-radius: 26px;
  background: rgba(255,255,255,.96);
  box-shadow: 0 10px 26px rgba(203,111,147,.18);
}

.lumitalk-profile-home-join::before {
  content: '';
  position: absolute;
  inset: 8px;
  border: 1px solid rgba(240,214,224,.95);
  border-radius: 20px;
  pointer-events: none;
}

.lumitalk-profile-home-join-copy,
.lumitalk-profile-home-join-slots,
.lumitalk-profile-home-join-button {
  position: relative;
  z-index: 1;
}

.lumitalk-profile-home-join-copy {
  text-align: center;
}

.lumitalk-profile-home-join-copy strong {
  display: block;
  color: var(--theme-text);
  font-size: 17px;
  line-height: 1.25;
  font-weight: 900;
  letter-spacing: -.05em;
}

.lumitalk-profile-home-join-copy p {
  margin: 10px 0 0;
  color: var(--theme-text-soft);
  font-size: 12px;
  line-height: 1.55;
  font-weight: 700;
}

.lumitalk-profile-home-join-slots {
  display: grid;
  grid-template-columns: repeat(3, minmax(0,1fr));
  gap: 10px;
  margin-top: 18px;
}

.lumitalk-profile-home-join-slots span {
  display: block;
  aspect-ratio: .78 / 1;
  border: 1px solid var(--theme-line);
  border-radius: 18px;
  background: linear-gradient(180deg, rgba(255,255,255,.98), rgba(252,239,246,.92));
}

.lumitalk-profile-home-join-button {
  width: 100%;
  min-height: 46px;
  margin-top: 18px;
  border: 1px solid rgba(244,128,170,.94);
  border-radius: 999px;
  background: rgba(244,128,170,.94);
  color: #fff;
  font: inherit;
  font-size: 15px;
  line-height: 1.2;
  font-weight: 900;
  letter-spacing: -.04em;
}

@media (max-width: 400px) {
  .lumitalk-profile-home-join {
    margin: 8px 10px 0;
    padding: 16px 14px;
    border-radius: 24px;
  }
  .lumitalk-profile-home-join::before { inset: 7px; border-radius: 18px; }
  .lumitalk-profile-home-join-copy strong { font-size: 16px; }
  .lumitalk-profile-home-join-copy p { font-size: 11px; }
  .lumitalk-profile-home-join-slots { gap: 8px; margin-top: 16px; }
  .lumitalk-profile-home-join-slots span { border-radius: 16px; }
  .lumitalk-profile-home-join-button { min-height: 44px; margin-top: 16px; font-size: 14px; }
}


/* LumiTalk membership state in channel list */
.lumitalk-status-chip--membership {
  border-color: #edc9d4;
  background: #fffafd;
  color: #d96491;
}

.lumitalk-channel-row.is-inactive-channel .lumitalk-channel-copy strong,
.lumitalk-channel-row.is-inactive-channel .lumitalk-channel-copy p {
  color: var(--theme-text-soft);
}

.lumitalk-state-text--inactive {
  color: var(--theme-point);
  font-weight: 850;
}


/* Viewer profile entry: same clean profile-home frame, no extra interaction invented */
.lumitalk-panel--viewer-profile .lumitalk-panel-scroll--profile-home {
  min-height:100%;
}
.lumitalk-panel--viewer-profile .lumitalk-profile-home-hero {
  padding-bottom: 104px;
}
.lumitalk-panel--viewer-profile .lumitalk-profile-home-hero::after {
  background: linear-gradient(180deg, rgba(255,255,255,0) 44%, rgba(245,201,219,.08) 68%, rgba(211,110,146,.18) 100%);
}
.lumitalk-viewer-profile-gallery {
  margin-top:-46px;
}
.lumitalk-profile-row:focus-visible {
  outline:2px solid rgba(244,128,170,.34);
  outline-offset:2px;
}


/* LumiTalk collection: channel-based saved message list */
.lumitalk-collection {
  min-height: 100%;
  background: var(--theme-bg);
}

.lumitalk-collection-header {
  display: grid;
  grid-template-columns: 44px minmax(0, 1fr) 44px;
  align-items: center;
  gap: 12px;
  min-height: 78px;
  padding: 14px 18px;
  border-bottom: 1px solid var(--theme-line);
  background: rgba(255,255,255,.82);
}

.lumitalk-collection-header > div {
  text-align: center;
}

.lumitalk-collection-header h3,
.lumitalk-collection-header p {
  margin: 0;
}

.lumitalk-collection-header h3 {
  color: var(--theme-text);
  font-size: 22px;
  line-height: 1.2;
  font-weight: 900;
  letter-spacing: -.06em;
}

.lumitalk-collection-header p {
  margin-top: 5px;
  color: var(--theme-text-soft);
  font-size: 11px;
  line-height: 1.45;
  font-weight: 700;
}

.lumitalk-collection-header::after {
  content: '';
  width: 44px;
  height: 44px;
}

.lumitalk-collection-back {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  padding: 0;
  border: 1px solid var(--theme-line);
  border-radius: 50%;
  background: rgba(255,255,255,.86);
  color: var(--theme-point-deep);
  font: inherit;
  font-size: 24px;
  line-height: 1;
  font-weight: 900;
}

.lumitalk-collection-scroll {
  min-height: calc(100% - 78px);
  padding: 20px 16px 30px;
  background: linear-gradient(180deg, rgba(255,255,255,.76), rgba(252,239,246,.86));
}

.lumitalk-collection-list {
  display: grid;
  gap: 14px;
}

.lumitalk-collection-row {
  display: grid;
  grid-template-columns: 72px minmax(0, 1fr) 24px;
  align-items: center;
  gap: 14px;
  width: 100%;
  min-height: 108px;
  padding: 16px;
  border: 1px solid var(--theme-line);
  border-radius: 22px;
  background: rgba(255,255,255,.92);
  text-align: left;
  box-shadow: 0 8px 18px rgba(167,93,120,.08);
}

.lumitalk-collection-image-slot {
  display: block;
  width: 72px;
  height: 72px;
  border: 1px solid var(--theme-line);
  border-radius: 18px;
  background: linear-gradient(180deg, rgba(255,255,255,.98), rgba(252,239,246,.92));
}

.lumitalk-collection-copy {
  display: block;
  min-width: 0;
}

.lumitalk-collection-copy strong,
.lumitalk-collection-copy small,
.lumitalk-collection-copy em {
  display: block;
}

.lumitalk-collection-copy strong {
  overflow: hidden;
  color: var(--theme-text);
  font-size: 17px;
  line-height: 1.25;
  font-weight: 900;
  letter-spacing: -.05em;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.lumitalk-collection-copy small {
  margin-top: 6px;
  color: var(--theme-point);
  font-size: 11px;
  line-height: 1.3;
  font-weight: 800;
}

.lumitalk-collection-copy em {
  overflow: hidden;
  margin-top: 7px;
  color: var(--theme-text-soft);
  font-size: 12px;
  line-height: 1.35;
  font-style: normal;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.lumitalk-collection-arrow {
  color: var(--theme-point);
  font-size: 30px;
  line-height: 1;
  font-weight: 700;
  text-align: right;
}

.lumitalk-collection-empty {
  padding: 48px 18px;
  border: 1px solid var(--theme-line);
  border-radius: 22px;
  background: rgba(255,255,255,.88);
  color: var(--theme-text-soft);
  font-size: 13px;
  line-height: 1.5;
  font-weight: 700;
  text-align: center;
}

@media (max-width: 400px) {
  .lumitalk-collection-header {
    grid-template-columns: 40px minmax(0, 1fr) 40px;
    min-height: 70px;
    padding: 12px 14px;
  }
  .lumitalk-collection-header::after,
  .lumitalk-collection-back { width: 40px; height: 40px; }
  .lumitalk-collection-header h3 { font-size: 20px; }
  .lumitalk-collection-header p { font-size: 10px; }
  .lumitalk-collection-scroll { padding: 16px 14px 24px; }
  .lumitalk-collection-row { grid-template-columns: 64px minmax(0, 1fr) 20px; gap: 12px; min-height: 96px; padding: 14px; }
  .lumitalk-collection-image-slot { width: 64px; height: 64px; border-radius: 16px; }
  .lumitalk-collection-copy strong { font-size: 15px; }
  .lumitalk-collection-copy em { font-size: 11px; }
}


/* LumiTalk collection detail: saved messages only */
.lumitalk-collection-detail-scroll {
  display: block;
  padding-top: 16px;
}

.lumitalk-collection-detail-list {
  display: grid;
  gap: 14px;
}

.lumitalk-collection-detail-card {
  position: relative;
  padding: 16px;
  border: 1px solid var(--theme-line);
  border-radius: 22px;
  background: rgba(255,255,255,.94);
}

.lumitalk-collection-detail-card-head {
  display: flex;
  align-items: center;
  gap: 10px;
}

.lumitalk-collection-detail-card-avatar,
.lumitalk-collection-detail-avatar,
.lumitalk-collection-detail-media-slot {
  display: block;
  border: 1px solid var(--theme-line);
  background: linear-gradient(180deg, rgba(255,255,255,.98), rgba(252,239,246,.92));
}

.lumitalk-collection-detail-card-avatar {
  width: 44px;
  height: 44px;
  flex: 0 0 auto;
  border-radius: 50%;
}

.lumitalk-collection-detail-card-copy {
  min-width: 0;
}

.lumitalk-collection-detail-card-copy strong,
.lumitalk-collection-detail-card-copy span {
  display: block;
}

.lumitalk-collection-detail-card-copy strong {
  color: var(--theme-text);
  font-size: 15px;
  line-height: 1.25;
  font-weight: 900;
  letter-spacing: -.05em;
}

.lumitalk-collection-detail-card-copy span {
  margin-top: 4px;
  color: var(--theme-text-soft);
  font-size: 10px;
  line-height: 1.4;
  font-weight: 700;
}

.lumitalk-collection-detail-saved-label {
  display: inline-flex;
  align-items: center;
  min-height: 24px;
  margin-top: 12px;
  padding: 0 10px;
  border: 1px solid var(--theme-line);
  border-radius: 999px;
  color: var(--theme-point);
  font-size: 10px;
  line-height: 1;
  font-weight: 800;
}

.lumitalk-collection-detail-message {
  display: grid;
  grid-template-columns: 40px minmax(0, 1fr);
  align-items: start;
  gap: 10px;
  margin-top: 14px;
  padding-top: 14px;
  border-top: 1px dashed var(--theme-line);
}

.lumitalk-collection-detail-avatar {
  width: 40px;
  height: 40px;
  border-radius: 50%;
}

.lumitalk-collection-detail-message strong,
.lumitalk-collection-detail-message p {
  margin: 0;
}

.lumitalk-collection-detail-message strong {
  display: block;
  color: var(--theme-text);
  font-size: 14px;
  line-height: 1.25;
  font-weight: 900;
}

.lumitalk-collection-detail-message p {
  margin-top: 7px;
  padding: 12px 13px;
  border: 1px solid var(--theme-line);
  border-radius: 16px;
  background: rgba(255,255,255,.8);
  color: var(--theme-text);
  font-size: 13px;
  line-height: 1.55;
  font-weight: 700;
  white-space: pre-wrap;
}

.lumitalk-collection-detail-media {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8px;
  margin-top: 12px;
}

.lumitalk-collection-detail-media-slot {
  aspect-ratio: 1 / 1;
  border-radius: 14px;
}

.lumitalk-collection-detail-note {
  margin-top: 14px;
  padding: 11px 12px;
  border: 1px solid var(--theme-line);
  border-radius: 14px;
  color: var(--theme-text-soft);
  font-size: 11px;
  line-height: 1.45;
  font-weight: 700;
}

.lumitalk-collection-detail-actions {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8px;
  margin-top: 14px;
}

.lumitalk-collection-detail-actions button {
  min-height: 38px;
  padding: 0 8px;
  border: 1px solid var(--theme-line);
  border-radius: 14px;
  background: rgba(255,255,255,.86);
  color: var(--theme-point-deep);
  font: inherit;
  font-size: 11px;
  line-height: 1.2;
  font-weight: 800;
}

.lumitalk-collection-detail-actions button:last-child {
  color: var(--theme-point);
}

@media (max-width: 400px) {
  .lumitalk-collection-detail-card { padding: 14px; border-radius: 20px; }
  .lumitalk-collection-detail-card-avatar { width: 40px; height: 40px; }
  .lumitalk-collection-detail-message { grid-template-columns: 38px minmax(0, 1fr); }
  .lumitalk-collection-detail-avatar { width: 38px; height: 38px; }
  .lumitalk-collection-detail-message p { font-size: 12px; }
  .lumitalk-collection-detail-actions { gap: 6px; }
  .lumitalk-collection-detail-actions button { min-height: 36px; font-size: 10px; }
}

